# This SSH config file can be passed to 'ssh -F'.
# This file is created by Lima, but not used by Lima itself currently.
# Modifications to this file will be lost on restarting the Lima instance.
Host lima-ubuntu
  IdentityFile "/Users/momiji/.lima/_config/user"
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  NoHostAuthenticationForLocalhost yes
  GSSAPIAuthentication no
  PreferredAuthentications publickey
  Compression no
  BatchMode yes
  IdentitiesOnly yes
  Ciphers "^aes128-gcm@openssh.com,aes256-gcm@openssh.com"
  User momiji
  ControlMaster auto
  ControlPath "/Users/momiji/.lima/ubuntu/ssh.sock"
  ControlPersist yes
  Hostname 127.0.0.1
  Port 54241

  Host dietpi.tail3009c.ts.net
    User dietpi
    HostName dietpi.tail3009c.ts.net
