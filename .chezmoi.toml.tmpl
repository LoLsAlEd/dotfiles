{{- /* Checks if running interactively, which is not the case for GitHub Codespaces */ -}}
{{- $interactive := stdinIsATTY -}}

{{- $name := promptStringOnce . "name" "Name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $gitSigningKey := get . "gitSigningKey" | default "" -}}
{{- if and $interactive (eq .chezmoi.os "darwin") -}}
{{-   $gitSigningKey = promptStringOnce . "gitSigningKey" "1Password Git signing public key (leave empty to disable signing)" "" -}}
{{- end -}}

{{- if $interactive -}}
{{-   writeToStdout "💡 Tip: you can re-enter your name and email with `chezmoi init --data=false`.\n" -}}
{{- end -}}

[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
gitSigningKey = {{ $gitSigningKey | quote }}

[edit]
{{- if lookPath "code" }}
command = "code"
args = ["--wait"]
{{- else if lookPath "nvim" }}
command = "nvim"
{{- else if lookPath "vim" }}
command = "vim"
{{- else if lookPath "nano" }}
command = "nano"
{{- end }}

[diff]
{{- if lookPath "delta" }}
pager = "delta"
{{- else if lookPath "bat" }}
pager = "bat --plain"
{{- else }}
pager = "less -R"
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
{{- $brewDirs := list "/opt/homebrew/bin" "/usr/local/bin" -}}
{{- $op := or (lookPath "op") (findExecutable "op" $brewDirs) -}}
{{- if not $op -}}
{{-   $brew := or (lookPath "brew") (findExecutable "brew" $brewDirs) -}}
{{-   if $brew -}}
{{-     $op = joinPath (dir $brew) "op" -}}
{{-   else if eq .chezmoi.arch "arm64" -}}
{{-     $op = "/opt/homebrew/bin/op" -}}
{{-   else -}}
{{-     $op = "/usr/local/bin/op" -}}
{{-   end -}}
{{- end -}}
[onepassword]
command = {{ $op | quote }}

[hooks.read-source-state.pre]
command = "/bin/bash"
args = [{{ joinPath .chezmoi.sourceDir ".install-password-manager.sh" | quote }}]
{{ end -}}
